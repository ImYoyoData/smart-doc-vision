{
  "name": "smartdoc-vision-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion promo video for SmartDoc Vision",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SmartDocPromo out/smartdoc-vision-promo.mp4 --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\" --codec=h264 --crf=18",
    "still": "remotion still src/index.ts SmartDocPromo out/poster.png --frame=240 --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\"",
    "render:launch": "remotion render src/index.ts SmartDocLaunch out/smartdoc-vision-launch.mp4 --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\" --codec=h264 --crf=18",
    "still:launch": "remotion still src/index.ts SmartDocLaunch out/launch-poster.png --frame=500 --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\""
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3"
  }
}
