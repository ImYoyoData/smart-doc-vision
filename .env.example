APP_ENV=development
SERVER_PORT=8080

# 使用本地 MySQL；库名可包含连字符
MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/smart-doc-vision?charset=utf8mb4&parseTime=True&loc=Local

# 本地 Redis：无密码，使用 DB 3
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=3

# 生产环境务必替换
JWT_SECRET=replace-with-a-long-random-secret
MASTER_KEY=replace-with-at-least-32-characters-master-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_COUNT=4
MEDIA_ALLOW_PRIVATE=false

# 首个通用大模型（OpenAI 兼容）
DEFAULT_AI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_AI_API_KEY=
DEFAULT_AI_SUPPORTS_VISION=false

# JEV（TypeSafe AI）默认值，API Key 可在后台填写
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
