# SmartDoc Vision configuration
# Single configuration file. Precedence: OS environment > .env > built-in defaults.
# config.yml is a legacy fallback only; new deployments should keep everything here.
# Admin UI: http://127.0.0.1:<SERVER_PORT>/admin

APP_ENV=production
# Local development: change to development
SERVER_PORT=8080

# MySQL: use individual fields, or set MYSQL_DSN to a full DSN (DSN wins).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=smart-doc-vision
MYSQL_CHARSET=utf8mb4
# MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/smart-doc-vision?charset=utf8mb4&parseTime=True&loc=Local

# Redis: REDIS_ADDR overrides REDIS_HOST/REDIS_PORT when set.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
# REDIS_ADDR=127.0.0.1:6379

# Change these in production.
JWT_SECRET=replace-with-a-long-random-secret
MASTER_KEY=replace-with-at-least-32-characters-master-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# Site branding. Restart after editing. SITE_LOGO accepts a local image path,
# an https URL, or a data:image/... URI; leave empty to use the built-in mark.
SITE_NAME=智审图档
SITE_NAME_EN=SmartDoc Vision
SITE_LOGO=

# 手机/局域网调试时把 http://<局域网IP>:5173 追加到 CORS_ORIGINS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
WORKER_COUNT=4
MEDIA_ALLOW_PRIVATE=false

# Default generic model (OpenAI compatible)
DEFAULT_AI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_AI_API_KEY=
DEFAULT_AI_SUPPORTS_VISION=false

# JEV / TypeSafe defaults
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# File storage. Uploaded images/files are stored here, not in MySQL.
# local: a directory on this machine. In Docker, mount it to a persistent volume.
# s3:    any S3-compatible provider (Alibaba OSS, Tencent COS, Qiniu Kodo, AWS, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads
# Optional CDN/public domain that maps to the storage root.
STORAGE_PUBLIC_BASE_URL=
# aliyun | tencent | qiniu | aws | minio | custom
STORAGE_S3_PROVIDER=aliyun
# Leave empty for known providers to derive from the region.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=cn-hangzhou
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PREFIX=
STORAGE_S3_FORCE_PATH_STYLE=false
