# =============================================================================
# SmartDoc Vision 配置文件（.env）
# -----------------------------------------------------------------------------
# 1. 本文件只在进程启动时读取一次：修改或新增任意一项后，必须重启服务才会生效。
# 2. 优先级：系统环境变量 > .env > config.yml（旧版兼容） > 内置默认值。
# 3. 后台账号（超级管理员、普通用户）保存在数据库中，由安装向导创建、
#    在「账号管理」页面维护。本文件不包含任何账号密码，修改这里不会影响已有账号。
# 4. MASTER_KEY 用于加密数据库中的模型密钥、接入凭证 AppSecret、通知渠道配置等。
#    首次安装后绝对不要修改；一旦修改，所有已加密数据将无法解密（等同于丢失）。
# 5. 从旧版本升级：程序启动时会自动把旧版 MYSQL_* / ADMIN_* 配置转换为本文件的
#    DB_* 格式，并将原文件备份为 .env.bak.<时间戳>。
# =============================================================================

# ================================ 运行环境 ====================================
# production / development。生产环境请保持 production；
# development 会放宽 CORS 并输出更详细的调试信息。
APP_ENV=production
# 时区：日志、任务时间、报表按天统计和数据库写入都使用该时区。
# 默认 Asia/Shanghai；填 Local 表示跟随服务器操作系统时区。修改后需重启。
APP_TIMEZONE=Asia/Shanghai
# HTTP 监听地址。默认 0.0.0.0 表示监听全部网卡；
# 只允许本机访问可改为 127.0.0.1，也可用启动参数 -host 临时覆盖。
SERVER_HOST=0.0.0.0
# HTTP 监听端口。修改后需重启，并同步调整反向代理和 SITE_URL；
# 也可用启动参数 -port 临时覆盖。
SERVER_PORT=8080

# ================================= 数据库 =====================================
# 数据库类型：mysql 或 postgres（PostgreSQL）。
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart-doc-vision
# MySQL 专用：字符集，通常保持 utf8mb4。PostgreSQL 部署请删除本行。
DB_CHARSET=utf8mb4
# PostgreSQL 专用：disable / require / verify-ca / verify-full。MySQL 部署请删除本行。
# DB_SSLMODE=disable
# 可选：完整连接串，填写后优先于上面的分项配置。
# MySQL 示例：
# DB_DSN=root:your_password@tcp(127.0.0.1:3306)/smart-doc-vision?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL 示例：
# DB_DSN=postgres://postgres:your_password@127.0.0.1:5432/smart-doc-vision?sslmode=disable
#
# 兼容旧版配置（仍可使用，但推荐改为上面的 DB_* 写法）：
# MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_CHARSET / MYSQL_DSN

# ================================== Redis ====================================
# 用于任务队列、去重锁、运行监控与缓存。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=3

# ================================ 安全密钥 ====================================
# JWT 登录令牌的签名密钥；修改后所有已登录会话立即失效，可以随时更换。
JWT_SECRET=replace-with-a-long-random-secret
# 数据加密主密钥；用于加密数据库中的敏感配置，首次安装后不要修改（见文件顶部）。
# 建议使用至少 32 位随机字符串（例如 openssl rand -hex 32 的输出）。
MASTER_KEY=replace-with-at-least-32-characters-master-key

# ================================ 站点品牌 ====================================
# 修改后需重启；也可以留空，在「系统配置 → 站点品牌」中在线修改名称与 Logo。
SITE_NAME=智审图档
SITE_NAME_EN=SmartDoc Vision
# SITE_LOGO 支持 https 地址、data:image 或服务器本地图片路径；通常留空在线设置。
# SITE_LOGO=
# 对外访问地址，用于通知邮件中的直达链接，末尾不要带 /。
SITE_URL=http://127.0.0.1:8080

# ================================ 运行参数 ====================================
# 允许跨域访问的页面来源，多个用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 审核 Worker 并发数，范围 1~32。
WORKER_COUNT=4
# 是否允许模型读取内网地址（生产环境建议 false）。
MEDIA_ALLOW_PRIVATE=false

# ================================ 文件存储 ====================================
# local：服务器本地目录；s3：任意 S3 兼容对象存储。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads
#
# 使用对象存储时把 STORAGE_DRIVER 改为 s3，并取消下面的注释：
# STORAGE_S3_PROVIDER=aliyun        # aliyun | tencent | qiniu | aws | minio | custom
# STORAGE_S3_REGION=cn-hangzhou
# STORAGE_S3_BUCKET=smartdoc-uploads
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# 已知服务商可留空，由服务商与 Region 自动推导；MinIO/自定义必须填写完整地址。
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_PREFIX=
# STORAGE_S3_FORCE_PATH_STYLE=false
# 可选：CDN 或公开访问域名
# STORAGE_PUBLIC_BASE_URL=
