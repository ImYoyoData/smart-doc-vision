# SmartDoc Vision structured configuration.
# Copy this file to config.yml next to the executable or start command.
# Precedence: OS environment > config.yml > .env > built-in defaults.
# Admin UI: http://127.0.0.1:<http.port>/admin

http:
  port: 8080

mysql:
  host: 127.0.0.1
  port: 3306
  user: root
  password: "your_password"
  database: smart-doc-vision
  charset: utf8mb4
  # Full DSN takes precedence over the individual fields:
  # dsn: "root:your_password@tcp(127.0.0.1:3306)/smart-doc-vision?charset=utf8mb4&parseTime=True&loc=Local"

redis:
  host: 127.0.0.1
  port: 6379
  password: ""
  db: 3
  # addr: "127.0.0.1:6379"

security:
  jwt_secret: "replace-with-a-long-random-secret"
  master_key: "replace-with-at-least-32-characters-master-key"

admin:
  username: admin
  password: "Admin@123456"

cors:
  origins:
    - http://localhost:5173
    - http://127.0.0.1:5173

worker_count: 4
media:
  allow_private: false

ai:
  # Default OpenAI-compatible provider, used only when the demo project is seeded.
  openai_base_url: https://api.openai.com/v1
  openai_model: gpt-4o-mini
  openai_api_key: ""
  openai_supports_vision: false

  # JEV / TypeSafe defaults; the API Key is configured in the admin UI.
  jev_base_url: https://api.typesafe.ai/v1
  jev_model: jev-latest
